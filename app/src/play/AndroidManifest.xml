<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play edition. Play only allows USE_EXACT_ALARM for alarm-clock and calendar apps, so the Play
     build asks the user once for "Alarms & reminders" instead (the app shows a banner with a button). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:remove="android:maxSdkVersion"/>
</manifest>
